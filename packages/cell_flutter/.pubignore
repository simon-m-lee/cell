# Member-specific publish ignores.
# This file overrides the workspace-root .pubignore (which excludes
# /packages/** so the umbrella package stays lean).
# NOTE: see tool/release-publish.sh — the root `/packages/**` rule must be
# neutralised while publishing workspace members.
coverage/
build/

# Tooling and benchmarks stay in the repository, not in the published
# package: benchmark/ is its own package (its pubspec would confuse pub)
# and tool/ are maintainer scripts.
benchmark/
tool/
